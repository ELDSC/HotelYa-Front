{
  "version": 1,
  "projects": {
    "hotelya": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "polyfills": ["@angular/localize/init"]
          },
          "configurations": {
            "production": {
              "optimization": {
                "fonts": false
              },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "host": "127.0.0.1",
            "port": 5173
          },
          "configurations": {
            "development": {
              "buildTarget": "hotelya:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
