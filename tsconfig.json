{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "types": ["vite/client", "node"], "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "noEmit": true, "strict": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true, "skipLibCheck": true
  },
  "include": ["src", "tests", "*.config.ts"]
}
